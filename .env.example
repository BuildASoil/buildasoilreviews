# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file to git.

# --- Okendo (required for review sync) ---
# Get these from Okendo: Admin → Settings → Integrations → API
OKENDO_USER_ID=paste_your_user_id_here
OKENDO_API_KEY=paste_your_api_key_here

# --- Google Places API (optional, for live Google reviews on homepage) ---
# Get these from console.cloud.google.com after enabling the Places API
# If not set, the Google card on the homepage will simply not appear
GOOGLE_PLACES_API_KEY=paste_your_google_api_key_here
GOOGLE_PLACE_ID=ChIJs2tIOZJWP4cRfMXqkul-qao
